[Unit]
Description=Остатки с Ozon для позиций, которые не ведёт склад
After=network-online.target medusa-server.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/root/.volento-secrets
EnvironmentFile=/home/volento/volento/apps/backend/.env
ExecStart=/usr/bin/python3 /home/volento/ozon-ostatki.py
