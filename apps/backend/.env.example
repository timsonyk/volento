# Образец. Реальные значения лежат в .env на сервере и в git не попадают.
NODE_ENV=production

DATABASE_URL=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5432/БАЗА

REDIS_URL=redis://localhost:6379/0
EVENTS_REDIS_URL=redis://localhost:6379/1
WE_REDIS_URL=redis://localhost:6379/2
CACHE_REDIS_URL=redis://localhost:6379/3

JWT_SECRET=СЛУЧАЙНАЯ_СТРОКА
COOKIE_SECRET=СЛУЧАЙНАЯ_СТРОКА
AUTH_MFA_ENCRYPTION_KEY=СЛУЧАЙНАЯ_СТРОКА

STORE_CORS=https://ваш-домен
ADMIN_CORS=https://api.ваш-домен
AUTH_CORS=https://api.ваш-домен,https://ваш-домен
